    "VIBERSYN_SKY_INTERVAL_MS": "120000",
    "VIBERSYN_BUILDS_ROOT": "builds/local",
    "VIBERSYN_EXECUTION_ROOT": "artifacts/local-runs",
    "VIBERSYN_STATE_FILE": "builds/local/.room-state.json",
    "VIBERSYN_TRANSCRIPT_ARCHIVE": "artifacts/local-transcripts"
  }
