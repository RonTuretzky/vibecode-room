{
  "description": "All AI on this computer: LM Studio, local Whisper transcription, and system speech. GitHub and web research remain available.",
  "env": {
    "VIBERSYN_LOCAL_AI": "1",
    "VIBERSYN_LOCAL_LLM_URL": "http://127.0.0.1:1234/v1",
