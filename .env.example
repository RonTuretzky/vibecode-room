# Copy to .env. Environment values override room-profiles/<name>.json.
VIBERSYN_ROOM_PROFILE=default
VIBERSYN_PORT=8787
# HOST=127.0.0.1
# VIBERSYN_PHONE_LISTENER=0
# VIBERSYN_PINNED_IMPORTS=https://github.com/owner/repo
# VIBERSYN_SMITHERS_GATEWAY_URL=ws://127.0.0.1:7777
# VIBERSYN_IDEA_DETECTOR=heuristic
# VIBERSYN_RESEARCH_AGENT=stub
# VIBERSYN_RESEARCH_SUGGESTER=heuristic
# Credentials, when needed, belong only in this untracked file.
# Project/job recovery (atomic JSON metadata; artifact directories stay on disk).
# VIBERSYN_STATE_FILE=builds/.room-state.json
# VIBERSYN_STATE_FILE=off
# Imported-branch implementation uses your local authenticated Claude CLI.
# VIBERSYN_CLAUDE_CLI=/absolute/path/to/claude
# VIBERSYN_BRANCH_MODEL=sonnet
# VIBERSYN_STEER_APPLIER=0
# Explicit notes-only demonstrations (never an automatic fallback):
# VIBERSYN_BRANCH_WRITER=notes
